              "row": 3,
              "col": 0,
              "icon": "folder",
              "color": "#6e5a3b",
              "action": {
                "type": "focus",
                "params": {
                  "process": "explorer"
                }
              }
            },
            {
              "id": "notify-test",
              "label": "Avvisami",
              "row": 3,
              "col": 1,
              "icon": "gear",
              "color": "#5b4b8a",
              "action": {
                "type": "notify",
                "params": {
                  "title": "Wdeck",
                  "message": "Promemoria dal telefono",
                  "sound": true
                }
              }
            },
            {
              "id": "lock-pc",
              "label": "Blocca",
              "row": 3,
              "col": 2,
              "icon": "power",
              "color": "#8a3b3b",
              "action": {
                "type": "power",
                "params": {
                  "command": "lock"
                }
              }
            },
            {
              "id": "shutdown-pc",
