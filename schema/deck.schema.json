{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wdeck.local/schema/deck.schema.json",
  "title": "Wdeck deck configuration",
  "description": "Schema di riferimento per deck.json. La validazione a runtime e' implementata in src/host/config/schema.mjs (che aggiunge anche controlli semantici: id univoci, celle non sovrapposte, target di navigazione esistenti).",
  "type": "object",
  "required": ["version", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "maxLength": 64 },
    "defaultProfile": { "$ref": "#/$defs/slug" },
    "settings": { "$ref": "#/$defs/settings" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
    "hexColor": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$" },
    "settings": {
      "type": "object",
      "properties": {
        "server": {
          "type": "object",
          "properties": {
            "host": { "type": "string", "description": "0.0.0.0 per esporre in LAN, 127.0.0.1 per solo locale" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "publicName": { "type": "string", "maxLength": 64 }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "requireToken": { "type": "boolean" },
            "token": { "type": "string", "minLength": 8 },
            "pin": { "type": "string", "pattern": "^[0-9]{4,12}$" },
            "dryRun": { "type": "boolean" },
            "allowUrlSchemes": { "type": "array", "items": { "type": "string" } },
            "allowedExtensions": { "type": "array", "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" } },
            "allowExec": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Percorsi o pattern glob consentiti per launch/script. Vuoto = tutto bloccato."
            },
            "maxSequenceSteps": { "type": "integer", "minimum": 1, "maximum": 256 }
          }
        },
        "ui": {
          "type": "object",
          "properties": {
            "theme": { "enum": ["dark", "light", "auto"] },
            "accent": { "$ref": "#/$defs/hexColor" },
            "showLabels": { "type": "boolean" }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "pages"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "maxLength": 64 },
        "defaultPage": { "$ref": "#/$defs/slug" },
        "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "rows", "cols", "buttons"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "maxLength": 64 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 8 },
        "cols": { "type": "integer", "minimum": 1, "maximum": 12 },
        "buttons": { "type": "array", "maxItems": 96, "items": { "$ref": "#/$defs/button" } }
      }
    },
    "button": {
      "type": "object",
      "required": ["id", "row", "col", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/slug", "description": "univoco nell'intero deck" },
        "label": { "type": "string", "maxLength": 48 },
        "row": { "type": "integer", "minimum": 0, "maximum": 7 },
        "col": { "type": "integer", "minimum": 0, "maximum": 11 },
        "icon": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,23}$" },
        "color": { "$ref": "#/$defs/hexColor" },
        "textColor": { "$ref": "#/$defs/hexColor" },
        "action": { "$ref": "#/$defs/action" },
        "holdAction": { "$ref": "#/$defs/action" }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Tipo registrato nel registro azioni dell'host",
          "examples": ["launch", "url", "media", "hotkey", "text", "script", "sequence", "delay", "http", "navigate", "noop", "stub"]
        },
        "params": { "type": "object" }
      }
    }
  }
}
